[Unit]
Description=SIGES - Servidor de Aplicacao WSGI (Gunicorn)
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/siges
Environment="PATH=/var/www/siges/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/var/www/siges/.env
ExecStart=/var/www/siges/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=15
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
